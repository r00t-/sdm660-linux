/dts-v1/;

#include "sdm660-bbry-athena-common.dtsi"

/ {
	compatible = "bbry,athena-syna", "qcom,sdm660";
};

&panel {
	compatible = "syna,td4300-panel";

	panel-timing {
		clock-frequency = <127280160>;
		hactive = <1080>;
		hsync-len = <2>;
		hfront-porch = <120>;
		hback-porch = <40>;

		vactive = <1620>;
		vsync-len = <2>;
		vfront-porch = <8>;
		vback-porch = <6>;
	};
};
